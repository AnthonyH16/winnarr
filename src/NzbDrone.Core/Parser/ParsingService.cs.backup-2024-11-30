        private Episode FindRacingEpisode(Series series, int season, string gpName, string sessionType, string racingClass)
        {
            _logger.Info("FindRacingEpisode called: Series='{0}', Season={1}, GP='{2}', Session='{3}', Class='{4}'", series.Title, season, gpName, sessionType, racingClass ?? "none");

            if (string.IsNullOrWhiteSpace(gpName) || string.IsNullOrWhiteSpace(sessionType))
            {
                _logger.Debug("Racing episode search requires both GP name and session type");
                return null;
            }

            var episodes = _episodeService.GetEpisodesBySeason(series.Id, season);

            if (!episodes.Any())
            {
                _logger.Warn("No episodes found for season {0} in series '{1}' (ID: {2})", season, series.Title, series.Id);
                return null;
            }

            _logger.Info("Found {0} episodes in season {1}", episodes.Count, season);

            // Build list of GP name variations to search for
            var normalizedGpName = gpName.CleanSeriesTitle();
            var gpNameVariations = new List<string> { normalizedGpName, gpName.ToLower() };

            // Add known variations from the mapping using STRICT matching
            // CRITICAL: Use word boundary matching to prevent "australia" from matching "austria" variations
            var matchedKeys = new List<KeyValuePair<string, string[]>>();

            foreach (var kvp in GpNameVariations)
            {
                var cleanKey = kvp.Key.CleanSeriesTitle();

                // Check if this key matches the GP name using STRICT rules
                // 1. Exact match (case-insensitive)
                if (string.Equals(normalizedGpName, cleanKey, StringComparison.OrdinalIgnoreCase))
                {
                    matchedKeys.Add(kvp);
                    continue;
                }

                // 2. Word boundary match - use regex to ensure we match complete words
                // This prevents "aus" from matching within "austria" or "australia"
                try
                {
                    var keyPattern = $@"\b{Regex.Escape(cleanKey)}\b";
                    var gpPattern = $@"\b{Regex.Escape(normalizedGpName)}\b";

                    if (Regex.IsMatch(normalizedGpName, keyPattern, RegexOptions.IgnoreCase) ||
                        Regex.IsMatch(cleanKey, gpPattern, RegexOptions.IgnoreCase))
                    {
                        matchedKeys.Add(kvp);
                    }
                }
                catch (ArgumentException)
                {
                    // If regex fails, fall back to exact match only (already handled above)
                }
            }

            // Sort by key length descending - prioritize longer/more specific keys
            // "australia" (9 chars) will be processed before "aus" (3 chars)
            foreach (var kvp in matchedKeys.OrderByDescending(k => k.Key.Length))
            {
                gpNameVariations.AddRange(kvp.Value);
            }

            gpNameVariations = gpNameVariations.Distinct().ToList();

            _logger.Info("GP name variations for '{0}': [{1}]", gpName, string.Join(", ", gpNameVariations));
            _logger.Info("TEST: About to normalize session type: {0}", sessionType);

            var normalizedSession = sessionType.ToLower();

            // Normalize "quali" and "qf" to "qualifying"
            if (normalizedSession == "quali" || normalizedSession == "qf")
            {
                normalizedSession = "qualifying";
            }

            // Build list of session type variations to search for
            // TVDB uses different naming conventions (e.g., "Q 1" vs "Q1" vs "Qualifying")
            var sessionVariations = new List<string> { normalizedSession };

            // Handle compound sessions like "fp4-quali", "fp4quali" - extract both parts
            var compoundMatch = Regex.Match(normalizedSession, @"^(fp[1-4])[.\s_-]?(qualifying|quali)$", RegexOptions.IgnoreCase);
            if (compoundMatch.Success)
            {
                // Add both the FP session and qualifying session variations
                var fpPart = compoundMatch.Groups[1].Value.ToLower();
                var fpNumber = fpPart.Replace("fp", "");
                sessionVariations.AddRange(new[] { $"fp {fpNumber}", $"fp{fpNumber}", $"practice {fpNumber}", $"practice{fpNumber}", $"free practice {fpNumber}" });
                sessionVariations.AddRange(new[] { "qualifying", "quali", "q 2", "q2", "q 1", "q1" });
            }

            // Handle Q1/Q2 variations (filenames use "Q1", TVDB uses "Q 1")
            // Also handle "Qualifying One" and "Qualifying Two" style names
            // IMPORTANT: Include "qualifying" prefix to avoid matching Free Practice Nr. 1/2
            if (normalizedSession == "q1" || normalizedSession == "qualifying q1" || normalizedSession == "qualifyingq1" ||
                normalizedSession == "qualifying one" || normalizedSession == "qualifyingone" ||
                normalizedSession == "quali q1" || normalizedSession == "qualiq1")
            {
                // Include "qualifying 1" for TVDB titles like "MALAYSIA - Sepang - Qualifying 1"
                sessionVariations.AddRange(new[] { "qualifying 1", "qualifying nr. 1", "qualifying q 1", "qualifying q1", "qualifying one", "quali nr. 1", "quali q 1", "quali q1", "q 1", "q1" });
            }
            else if (normalizedSession == "q2" || normalizedSession == "qualifying q2" || normalizedSession == "qualifyingq2" ||
                     normalizedSession == "qualifying two" || normalizedSession == "qualifyingtwo" ||
                     normalizedSession == "quali q2" || normalizedSession == "qualiq2")
            {
                // Include "qualifying 2" for TVDB titles like "MALAYSIA - Sepang - Qualifying 2"
                sessionVariations.AddRange(new[] { "qualifying 2", "qualifying nr. 2", "qualifying q 2", "qualifying q2", "qualifying two", "quali nr. 2", "quali q 2", "quali q2", "q 2", "q2" });
            }
            else if (normalizedSession == "qualifying" || normalizedSession == "quali")
            {
                // Generic "Qualifying" without Q1/Q2 specifier - default to Q2 (final qualifying)
                // Most scene releases use "Qualifying" to mean the full qualifying session or Q2
                sessionVariations.AddRange(new[] { "q 2", "q2", "qual", "quali", "q 1", "q1" });
            }

            // Handle FP variations (FP1 = Free Practice 1 = Practice 1 = FP 1)
            if (normalizedSession.StartsWith("fp"))
            {
                var fpNumber = normalizedSession.Replace("fp", "").Replace(" ", "").Replace(".", "");
                sessionVariations.AddRange(new[] { $"fp {fpNumber}", $"fp{fpNumber}", $"practice {fpNumber}", $"practice{fpNumber}", $"free practice {fpNumber}" });
            }
            else if (normalizedSession.StartsWith("practice"))
            {
                var practiceNumber = normalizedSession.Replace("practice", "").Replace(" ", "").Replace(".", "");
                if (!string.IsNullOrEmpty(practiceNumber))
                {
                    sessionVariations.AddRange(new[] { $"fp {practiceNumber}", $"fp{practiceNumber}", $"free practice {practiceNumber}" });
                }
            }

            // Handle Warm Up variations
            if (normalizedSession == "warmup" || normalizedSession == "warm up")
            {
                sessionVariations.AddRange(new[] { "warm up", "warmup", "warm-up" });
            }

            // Handle Test variations (pre-season, post-season testing)
            if (normalizedSession.StartsWith("test"))
            {
                // Matches "test", "test afternoon", "test morning", "test day 1", etc.
                sessionVariations.AddRange(new[] { "test", "testing", "shakedown" });

                // Add specific variations if present
                if (normalizedSession.Contains("afternoon"))
                {
                    sessionVariations.AddRange(new[] { "test afternoon", "afternoon session" });
                }
                else if (normalizedSession.Contains("morning"))
                {
                    sessionVariations.AddRange(new[] { "test morning", "morning session" });
                }
                else if (normalizedSession.Contains("day"))
                {
                    // Extract day number if present (e.g., "test day 1" -> "day 1")
                    var dayMatch = Regex.Match(normalizedSession, @"day\s*(\d+)", RegexOptions.IgnoreCase);
                    if (dayMatch.Success)
                    {
                        var dayNumber = dayMatch.Groups[1].Value;
                        sessionVariations.AddRange(new[] { $"test day {dayNumber}", $"day {dayNumber}" });
                    }
                }
            }

            // Handle Sprint variations
            // "Sprint" alone means Sprint Race, not Sprint Shootout/Sprint Qualifying
            if (normalizedSession == "sprint")
            {
                // TVDB 2024 uses "Sprint Shootout" for qualifying, "Sprint" for the race
                // TVDB 2025 uses "Sprint Qualifying" for qualifying, "Sprint Race" for the race
                // File with just "Sprint" should match "Sprint Race" or standalone "Sprint", but NOT "Sprint Shootout" or "Sprint Qualifying"
                sessionVariations.AddRange(new[] { "sprint race", "sprint" });
            }
            else if (normalizedSession == "sprint race" || normalizedSession == "sprintrace")
            {
                sessionVariations.AddRange(new[] { "sprint race", "sprint" });
            }
            else if (normalizedSession == "sprint qualifying" || normalizedSession == "sprint quali" || normalizedSession == "sprintqualifying")
            {
                sessionVariations.AddRange(new[] { "sprint qualifying", "sprint shootout" });
            }
            else if (normalizedSession == "sprint shootout" || normalizedSession == "sprintshootout")
            {
                sessionVariations.AddRange(new[] { "sprint shootout", "sprint qualifying" });
            }

            // Racing class is now passed directly from the parser (e.g., "moto2", "moto3", "motogp")
            _logger.Debug("Searching for racing episode: GP='{0}' (variations: [{1}]), Session='{2}' (variations: [{3}]), Class='{4}'",
                gpName, string.Join(", ", gpNameVariations), normalizedSession, string.Join(", ", sessionVariations), racingClass ?? "any");

            // Helper function to check if episode title contains any GP name variation
            bool TitleContainsGpName(string title)
            {
                var cleanTitle = title.CleanSeriesTitle().ToLower();
                var lowerTitle = title.ToLower();
                var matched = gpNameVariations.Any(gp =>
                {
                    var lowerGp = gp.ToLower();

                    // Use word boundary matching on original title to prevent "spa" from matching "España"
                    var pattern = $@"\b{Regex.Escape(lowerGp)}\b";
                    if (Regex.IsMatch(lowerTitle, pattern, RegexOptions.IgnoreCase))
                    {
                        return true;
                    }

                    // CleanSeriesTitle removes spaces/punctuation, so use Contains() for cleaned titles
                    // This handles accented characters: "Aragón" becomes "aragon" after cleaning
                    // IMPORTANT: Only use Contains() for longer terms (5+ chars) to prevent false positives
                    // Short codes like "aus" would match within "austria", "ger" within "german", etc.
                    // The word boundary check above handles short codes correctly on the original title
                    if (lowerGp.Length >= 5 && cleanTitle.Contains(lowerGp))
                    {
                        return true;
                    }

                    return false;
                });

                return matched;
            }

            // Find episode where title contains GP name, session type, and optionally the racing class
            // Search each session variation in priority order (e.g., Q2 before Q1 when session is "Qualifying")
            // Special handling for Sprint to avoid matching Sprint Shootout/Sprint Qualifying
            Episode matchingEpisode = null;

            foreach (var sessionVar in sessionVariations)
            {
                // Check for circuit-specific exclusions (used across all session types)
                // IMPORTANT: Do this BEFORE class matching to ensure circuit-specific REQUIRE logic is enforced
                var hasMonza = gpNameVariations.Any(v => v.ToLower().Contains("monza"));
                var hasImola = gpNameVariations.Any(v => v.ToLower().Contains("imola") || v.ToLower().Contains("emilia"));
                var hasMugello = gpNameVariations.Any(v => v.ToLower().Contains("mugello") || v.ToLower().Contains("toscana") || v.ToLower().Contains("tuscany"));

                // Check for USA circuit-specific names
                var hasCota = gpNameVariations.Any(v => v.ToLower().Contains("cota") || v.ToLower().Contains("austin"));
                var hasLasVegas = gpNameVariations.Any(v => v.ToLower().Contains("las vegas") || v.ToLower().Contains("vegas"));
                var hasMiami = gpNameVariations.Any(v => v.ToLower().Contains("miami"));

                // Check for Spain circuit-specific names (mainly for MotoGP which has 4 Spanish circuits)
                var hasJerez = gpNameVariations.Any(v => v.ToLower().Contains("jerez"));
                var hasCatalunya = gpNameVariations.Any(v => v.ToLower().Contains("catalunya") || v.ToLower().Contains("catalonia") || v.ToLower().Contains("barcelona"));
                var hasAragon = gpNameVariations.Any(v => v.ToLower().Contains("aragon"));
                var hasValencia = gpNameVariations.Any(v => v.ToLower().Contains("valencia"));

                // Check if circuit names actually appear in episode titles (TVDB doesn't always include circuit names)
                // Only require circuit name if it exists in at least one episode title
                // Use CleanSeriesTitle to remove accents (e.g., "Aragón" -> "Aragon")
                var episodeHasJerez = hasJerez && episodes.Any(ep => ep.Title.CleanSeriesTitle().ToLower().Contains("jerez"));
                var episodeHasCatalunya = hasCatalunya && episodes.Any(ep => ep.Title.CleanSeriesTitle().ToLower().Contains("catalunya") || ep.Title.CleanSeriesTitle().ToLower().Contains("catalonia") || ep.Title.CleanSeriesTitle().ToLower().Contains("barcelona"));
                var episodeHasAragon = hasAragon && episodes.Any(ep => ep.Title.CleanSeriesTitle().ToLower().Contains("aragon"));
                var episodeHasValencia = hasValencia && episodes.Any(ep => ep.Title.CleanSeriesTitle().ToLower().Contains("valencia"));
                var episodeHasMugello = hasMugello && episodes.Any(ep => ep.Title.CleanSeriesTitle().ToLower().Contains("mugello") || ep.Title.CleanSeriesTitle().ToLower().Contains("toscana") || ep.Title.CleanSeriesTitle().ToLower().Contains("tuscan"));

                _logger.Info($"Circuit flags: hasAragon={hasAragon}, episodeHasAragon={episodeHasAragon}, hasJerez={hasJerez}, episodeHasJerez={episodeHasJerez}, hasCatalunya={hasCatalunya}, episodeHasCatalunya={episodeHasCatalunya}, hasValencia={hasValencia}, episodeHasValencia={episodeHasValencia}");

                if (racingClass != null)
                {
                    // For MotoGP series, prefer episodes that explicitly mention the class
                    // This handles TVDB entries like "SAN MARINO - Misano - MotoGP race" vs "Moto3 race"
                    // IMPORTANT: Also enforce circuit-specific REQUIRE logic here to prevent mismatches

                    // Helper to build class-specific query with circuit requirements
                    Func<Episode, bool> BuildClassMatchPredicate(string requiredInTitle = null, string[] excludeFromTitle = null)
                    {
                        return ep => {
                            if (!TitleContainsGpName(ep.Title)) return false;
                            if (!ep.Title.ToLower().Contains(sessionVar.ToLower())) return false;
                            if (racingClass != null && !ep.Title.ToLower().Contains(racingClass.ToLower())) return false;
                            // Use CleanSeriesTitle to remove accents when checking required title (e.g., "Aragón" -> "Aragon")
                            if (requiredInTitle != null && !ep.Title.CleanSeriesTitle().ToLower().Contains(requiredInTitle.ToLower())) return false;
                            // Exclude unwanted terms (e.g., other Spain circuits when matching Aragon)
                            if (excludeFromTitle != null && excludeFromTitle.Any(exclude => ep.Title.CleanSeriesTitle().ToLower().Contains(exclude))) return false;
                            // Exclude "Sprint Race" episodes when matching plain "Race" session
                            if (sessionVar.ToLower() == "race" && ep.Title.ToLower().Contains("sprint")) return false;
                            return true;
                        };
                    }

                    // Apply circuit-specific REQUIRE logic for class matching (only if circuit name appears in TVDB)
                    // IMPORTANT: Check most specific circuits first to avoid generic "Spain" matching wrong circuit
                    if (episodeHasAragon)
                    {
                        _logger.Info($"Aragon circuit detected in file. hasAragon={hasAragon}, episodeHasAragon={episodeHasAragon}");
                        _logger.Info($"Searching for episodes with 'aragon' in title, excluding jerez/catalunya/valencia");
                        _logger.Info($"Total episodes to check: {episodes.Count}");

                        var predicate = BuildClassMatchPredicate("aragon", new[] { "jerez", "catalunya", "catalonia", "barcelona", "valencia" });

                        // Log each episode evaluation
                        foreach (var ep in episodes)
                        {
                            var epLower = ep.Title.ToLower();
                            var epClean = ep.Title.CleanSeriesTitle().ToLower();
                            var hasGpName = TitleContainsGpName(ep.Title);
                            var hasSession = epLower.Contains(sessionVar.ToLower());
                            var hasClass = racingClass != null && epLower.Contains(racingClass.ToLower());
                            var hasAragonTitle = epClean.Contains("aragon");
                            var hasExcluded = new[] { "jerez", "catalunya", "catalonia", "barcelona", "valencia" }.Any(ex => epClean.Contains(ex));
                            var hasSprint = epLower.Contains("sprint");
                            var matches = predicate(ep);

                            if (hasGpName || hasAragonTitle || hasExcluded)
                            {
                                _logger.Info($"  Ep {ep.Id} '{ep.Title}': gpName={hasGpName}, session={hasSession}, class={hasClass}, hasAragon={hasAragonTitle}, excluded={hasExcluded}, sprint={hasSprint}, MATCH={matches}");
