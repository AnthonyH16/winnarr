                                (ep.Title.ToLower().Contains("catalunya") || ep.Title.ToLower().Contains("catalonia") || ep.Title.ToLower().Contains("barcelona")));
                        }
                        else if (hasCatalunya)
                        {
                            // File has Catalunya but TVDB doesn't - match Spain without REQUIRE
                            matchingEpisode = episodes.FirstOrDefault(ep =>
                                TitleContainsGpName(ep.Title) &&
                                ep.Title.ToLower().Contains(sessionVar));
                        }
                        else if (episodeHasAragon)
                        {
                            // File has Aragon and TVDB has it - REQUIRE it
                            matchingEpisode = episodes.FirstOrDefault(ep =>
                                TitleContainsGpName(ep.Title) &&
                                ep.Title.ToLower().Contains(sessionVar) &&
                                ep.Title.ToLower().Contains("aragon"));
                        }
                        else if (hasAragon)
                        {
                            // File has Aragon but TVDB doesn't - match Spain without REQUIRE
                            matchingEpisode = episodes.FirstOrDefault(ep =>
                                TitleContainsGpName(ep.Title) &&
                                ep.Title.ToLower().Contains(sessionVar));
                        }
                        else if (episodeHasValencia)
                        {
                            // File has Valencia and TVDB has it - REQUIRE it
                            matchingEpisode = episodes.FirstOrDefault(ep =>
                                TitleContainsGpName(ep.Title) &&
                                ep.Title.ToLower().Contains(sessionVar) &&
                                ep.Title.ToLower().Contains("valencia"));
                        }
                        else if (hasValencia)
                        {
                            // File has Valencia but TVDB doesn't - match Spain without REQUIRE
                            matchingEpisode = episodes.FirstOrDefault(ep =>
                                TitleContainsGpName(ep.Title) &&
                                ep.Title.ToLower().Contains(sessionVar));
                        }
                        else
                        {
                            // No circuit-specific exclusions needed
                            matchingEpisode = episodes.FirstOrDefault(ep =>
                                TitleContainsGpName(ep.Title) &&
                                ep.Title.ToLower().Contains(sessionVar));
                        }
                    }
                }

                if (matchingEpisode != null)
                {
                    break;
                }
            }

            if (matchingEpisode != null)
            {
                _logger.Info("SUCCESS: Found racing episode: S{0:00}E{1:00} - {2}", matchingEpisode.SeasonNumber, matchingEpisode.EpisodeNumber, matchingEpisode.Title);
            }
            else
            {
                _logger.Warn("FAILURE: No matching racing episode found for GP '{0}' Session '{1}' in season {2}", gpName, sessionType, season);
                _logger.Info("Searched {0} episodes. Sample episode titles:", episodes.Count);
                foreach (var ep in episodes.Take(5))
                {
                    _logger.Info("  - S{0:00}E{1:00}: {2}", ep.SeasonNumber, ep.EpisodeNumber, ep.Title);
                }
                if (episodes.Count > 5)
                {
                    _logger.Info("  ... and {0} more episodes", episodes.Count - 5);
                }
            }

            return matchingEpisode;
        }
    }
}
